# Salin ke .env untuk lokal. Di Dokploy, isi Environment deployment lalu redeploy.
# Nilai aktif untuk lokal; blok STAGING di bawah adalah contoh override.
# Jangan commit .env, secret, private key Firebase, model, atau foto pegawai.
# Panduan: docs/docker.md, docs/fcm.md, docs/biometric-local-research.md.

# API: gunakan NODE_ENV=production di staging; port internal tetap 3000.
NODE_ENV=development
PORT=3000

# DATABASE DAN REDIS STANDALONE
# URL aktif berikut untuk API yang dijalankan langsung di komputer lokal.
# Di container staging, gunakan hostname layanan pada jaringan privat yang sama.
# localhost di container menunjuk container itu sendiri, bukan host/database lain.
# host.docker.internal hanya dapat dipakai jika layanan host memang terjangkau;
# published port yang terikat hanya pada 127.0.0.1 tidak otomatis bisa dijangkau.
# URL-encode karakter khusus pada username/password URL.
# PostgreSQL memerlukan paket PostGIS; migration 004 mengaktifkan extension.
DATABASE_URL=postgresql://absensi:replace-with-external-password@localhost:55432/absensi
REDIS_URL=redis://localhost:56379
# Pool per proses API; sisakan koneksi untuk worker, migrasi dan monitoring.
DB_POOL_MAX=15
# Tidak diset di sini: npm run dev default false; Dockerfile/compose.yaml default true.
# Jika diaktifkan, API menjalankan migrasi saat startup. Worker tidak bermigrasi.
# Jika false, jalankan npm run db:migrate:production sebelum worker dimulai.
# DB_MIGRATE_ON_START=true

# Hanya untuk compose.postgres.yaml dan compose.redis.yaml, terpisah dari API.
# Jangan jalankan datastore baru jika DevOps sudah menyediakan layanan standalone.
# POSTGRES_PASSWORD harus cocok dengan password DATABASE_URL (asli, bukan encoded).
# Published port default hanya 127.0.0.1; koneksi antarcontainer perlu jaringan privat.
POSTGRES_USER=absensi
POSTGRES_DB=absensi
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
REDIS_PORT=56379

# SECRET API: buat masing-masing secara terpisah, jangan gunakan satu nilai bersama.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Opsional untuk startup login/admin; wajib untuk enrollment dan absensi biometrik.
# Harus berupa 32 byte base64. Pertahankan key asli untuk template yang sudah ada.
BIOMETRIC_KEY_BASE64=

# WEB ADMIN DAN REVERSE PROXY
# React Native native tidak memerlukan origin browser pada CORS.
# Browser client: isi origin yang dipakai, dipisahkan koma, tanpa path/trailing slash.
CORS_ORIGINS=http://localhost:8081
# Panel belum tersedia: false. Aktifkan setelah origin panel HTTPS sudah diketahui.
# Panel dan API gunakan subdomain same-site agar cookie web dapat bekerja.
WEB_AUTH_ENABLED=false
ADMIN_WEB_ORIGIN=
# Lokal langsung: kosong. Staging: IP/CIDR proxy sebenarnya, dipisahkan koma.
# Jangan isi true atau 0.0.0.0/0.
TRUST_PROXY=

# GOOGLE LOGIN: terpisah dari Firebase Cloud Messaging dan adaptor SSO instansi.
# Aktifkan setelah OAuth Android dan konfigurasi FE siap; tidak aktif otomatis.
GOOGLE_ENABLED=false
# Penautan email pertama juga butuh akun aktif EMPLOYEE/VERIFIER kategori KPID/KI,
# auth_mode SSO/BOTH, dan izin per akun google_email_linking_allowed=true.
GOOGLE_EMAIL_LINKING_ENABLED=false
# Web OAuth Client ID juga dipakai FE Android sebagai serverClientId.
# Nama yang dibaca API adalah GOOGLE_WEB_CLIENT_ID, bukan GOOGLE_CLIENT_ID.
GOOGLE_WEB_CLIENT_ID=
# Daftar OAuth Android Client ID, dipisahkan koma; bukan package name atau SHA-1.
GOOGLE_ANDROID_CLIENT_IDS=
# Secret dan callback wajib jika GOOGLE_ENABLED=true serta WEB_AUTH_ENABLED=true.
# Simpan secret terbaru melalui Environment Dokploy, bukan source code.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Authorized redirect URI Google Console untuk web admin staging:
# https://api-absensi-kpid-ki.sumutcerdas.web.id/api/v1/auth/web/google/callback
# Native Android memakai ID token; tidak membutuhkan callback web tersebut.

# ADAPTOR OIDC INSTANSI: biarkan false saat memakai integrasi Google di atas.
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_TOKEN_AUTH_METHOD=none

# BIOMETRIK: API dan face-worker adalah proses/service terpisah.
# Lokal: http://localhost:8000. compose.yaml menetapkan http://face-worker:8000.
# Application Dockerfile: isi hostname privat worker yang sebenarnya pada API.
FACE_WORKER_URL=http://localhost:8000
# Secret minimal 32 karakter; nilai harus sama pada API dan worker wajah.
FACE_WORKER_TOKEN=
# Nilai kosong tetap menonaktifkan biometrik; tidak ada default penerimaan produksi.
# Untuk pilot eksplisit gunakan lima nilai pada config/biometric-pilot.env.
FACE_MODEL_VERSION=
# Cosine similarity, bukan persentase akurasi; cutoff awal dari pemilik proyek.
FACE_MATCH_THRESHOLD=0.80
FACE_REVIEW_THRESHOLD=
FACE_LIVENESS_THRESHOLD=
FACE_QUALITY_THRESHOLD=
# Worker lokal/Application Dockerfile membaca FACE_MANIFEST_PATH di filesystem-nya.
# Model tidak diunduh otomatis dan tidak dibundel dalam image.
FACE_WORKER_PORT=8000
FACE_MANIFEST_PATH=
# Default menolak paket riset. true hanya untuk pilot terisolasi, bukan izin operasional.
FACE_ALLOW_RESEARCH_MODELS=false
# Khusus Compose: sumber direktori HOST dan path manifest DI DALAM container worker.
# Compose memasang sumber tersebut read-only ke /app/models.
FACE_MODELS_PATH=./models
FACE_WORKER_MANIFEST_PATH=/app/models/manifest.json

# FCM: API mendaftarkan token; notification-worker terpisah mengirim pengingat.
# Aktifkan profil notifications hanya jika FCM_ENABLED=true dan JSON sudah tersedia.
FCM_ENABLED=false
# Sesuai proyek Firebase FE Android. Berbeda dari project OAuth Google diperbolehkan.
FIREBASE_PROJECT_ID=absensi-439de
# Lokal: path absolut JSON service account. Compose: path file di HOST server.
# Compose memasangnya read-only ke /run/secrets/firebase-admin.json dan mengatur
# GOOGLE_APPLICATION_CREDENTIALS di worker ke path container tersebut otomatis.
# Application Dockerfile: isi path DI DALAM worker, dengan mount file terpisah.
# API tidak membutuhkan JSON ini; pastikan user non-root worker dapat membacanya.
GOOGLE_APPLICATION_CREDENTIALS=
NOTIFICATION_WORKER_PORT=8001
NOTIFICATION_WORKER_URL=http://localhost:8001
NOTIFICATION_POLL_MS=10000

# STAGING PILOT: terapkan override SECARA EKSPLISIT di Dokploy, bukan uncomment semua.
# Ganti hostname database/Redis, secret, dan path sesuai server sebenarnya.
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST_DATABASE:5432/NAMA_DATABASE
# REDIS_URL=redis://HOST_REDIS:6379
# DB_MIGRATE_ON_START=true
# CORS_ORIGINS=
# FACE_MODEL_VERSION=research-buffalo-sc-minifasnet-v2-v1
# FACE_MATCH_THRESHOLD=0.80
# FACE_REVIEW_THRESHOLD=0.70
# FACE_LIVENESS_THRESHOLD=0.90
# FACE_QUALITY_THRESHOLD=1.00
# FACE_ALLOW_RESEARCH_MODELS=true
# FACE_MODELS_PATH=/opt/absensi-models
# FACE_WORKER_MANIFEST_PATH=/app/models/research/manifest.json
# Empat file harus tersedia di /opt/absensi-models/research pada HOST:
# detector.onnx, recognizer.onnx, pad.onnx, manifest.json.
# Application Dockerfile worker: mount /opt/absensi-models ke /app/models read-only,
# lalu isi FACE_MANIFEST_PATH=/app/models/research/manifest.json pada worker.
# Threshold pilot belum dikalibrasi. Enrollment saat ini perlu persetujuan admin.
# FCM_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=/opt/absensi/secrets/firebase-admin.json
# Worker FCM memakai project absensi-439de; JSON tidak boleh masuk Git/image/APK.
# Aktifkan profil biometrics dan notifications pada deployment Compose yang sama.
# Service harus satu jaringan privat yang sesuai; worker tidak perlu domain/port publik.
# Health API: port 3000 path /ready/auth; worker wajah: port 8000 path /ready + bearer;
# worker notifikasi: port 8001 path /ready. Override health worker jika pakai Dockerfile.
