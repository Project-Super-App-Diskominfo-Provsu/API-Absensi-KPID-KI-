NODE_ENV=development
PORT=3000
# FCM API token registration and separate reminder worker (disabled by default).
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute private service-account JSON path. Mount read-only on the worker in Docker.
GOOGLE_APPLICATION_CREDENTIALS=
NOTIFICATION_WORKER_PORT=8001
NOTIFICATION_POLL_MS=10000
# PostgreSQL requires PostGIS packages; migration 004 enables the extension.
# External services. Use host.docker.internal instead of localhost when running
# the API in Docker and the database/Redis on the Docker host.
DATABASE_URL=postgresql://absensi:replace-with-external-password@localhost:55432/absensi
# Optional local datastore Compose files. Match the database URL credentials.
POSTGRES_USER=absensi
POSTGRES_DB=absensi
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
REDIS_PORT=56379
# Per API replica; reserve connections for migrations, monitoring and other apps.
DB_POOL_MAX=15
# Docker defaults to automatic migrations. Set false only with a separate migration step.
# DB_MIGRATE_ON_START=true
REDIS_URL=redis://localhost:56379
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Optional for auth/admin startup; required for enrollment and biometric attendance.
# Reuse the original key for existing encrypted face templates.
BIOMETRIC_KEY_BASE64=
CORS_ORIGINS=http://localhost:8081
# Web panel: use same-site HTTPS admin/API subdomains in staging/production.
WEB_AUTH_ENABLED=false
ADMIN_WEB_ORIGIN=
# Google native Android uses a Web OAuth client as its ID-token audience.
GOOGLE_ENABLED=false
# Optional first native login: match verified Gmail/Workspace email to an active SSO/BOTH employee.
GOOGLE_EMAIL_LINKING_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_IDS=
# Required only when enabling Google login for the web panel.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Empty for direct local access. In staging, list only the actual reverse proxy IPs/CIDRs.
TRUST_PROXY=
# OIDC adapter. Keep disabled until the institution confirms protocol and registration.
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_TOKEN_AUTH_METHOD=none
FACE_WORKER_URL=http://localhost:8000
FACE_WORKER_TOKEN=
# Other thresholds require model/PAD calibration. Empty values disable biometric operations.
FACE_MODEL_VERSION=
# Requested cosine similarity cutoff; not an accuracy percentage or a calibrated result.
FACE_MATCH_THRESHOLD=0.80
FACE_REVIEW_THRESHOLD=
FACE_LIVENESS_THRESHOLD=
FACE_QUALITY_THRESHOLD=
# Worker listens on a separate port. Models are never downloaded automatically.
FACE_WORKER_PORT=8000
FACE_MANIFEST_PATH=
# Explicit opt-in for isolated staging research evaluation, not operational attendance.
FACE_ALLOW_RESEARCH_MODELS=false
# Compose bind mount and in-container manifest path; separate from local FACE_MANIFEST_PATH.
FACE_MODELS_PATH=./models
FACE_WORKER_MANIFEST_PATH=/app/models/manifest.json
