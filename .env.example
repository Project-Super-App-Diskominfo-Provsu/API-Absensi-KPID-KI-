NODE_ENV=development
PORT=3000
# PostgreSQL requires PostGIS packages; migration 004 enables the extension.
# External services. Use host.docker.internal instead of localhost when running
# the API in Docker and the database/Redis on the Docker host.
DATABASE_URL=postgresql://absensi:replace-with-external-password@localhost:5432/absensi
# Per API replica; reserve connections for migrations, monitoring and other apps.
DB_POOL_MAX=15
# Docker defaults to automatic migrations. Set false only with a separate migration step.
# DB_MIGRATE_ON_START=true
REDIS_URL=redis://localhost:6379
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Optional for auth/admin startup; required for enrollment and biometric attendance.
# Reuse the original key for existing encrypted face templates.
BIOMETRIC_KEY_BASE64=
CORS_ORIGINS=http://localhost:8081
# Web panel: use same-site HTTPS admin/API subdomains in staging/production.
WEB_AUTH_ENABLED=false
ADMIN_WEB_ORIGIN=
# Google native Android uses a Web OAuth client as its ID-token audience.
GOOGLE_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_IDS=
# Required only when enabling Google login for the web panel.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Empty for direct local access. In staging, list only the actual reverse proxy IPs/CIDRs.
TRUST_PROXY=
# OIDC adapter. Keep disabled until the institution confirms protocol and registration.
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_TOKEN_AUTH_METHOD=none
FACE_WORKER_URL=http://localhost:8000
FACE_WORKER_TOKEN=
# Set only after model/PAD calibration. Empty values disable biometric operations.
FACE_MODEL_VERSION=
FACE_MATCH_THRESHOLD=
FACE_REVIEW_THRESHOLD=
FACE_LIVENESS_THRESHOLD=
FACE_QUALITY_THRESHOLD=
# Worker listens on a separate port. Models are never downloaded automatically.
FACE_WORKER_PORT=8000
FACE_MANIFEST_PATH=
