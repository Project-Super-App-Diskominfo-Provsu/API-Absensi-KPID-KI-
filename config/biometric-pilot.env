# Pilot policy for this exact model; not calibrated accuracy or production defaults.
# Apply explicitly to API environment. This file contains no credentials.
FACE_MODEL_VERSION=research-buffalo-sc-minifasnet-v2-v1
# Owner-selected cosine similarity cutoff, also used for enrollment consistency.
FACE_MATCH_THRESHOLD=0.80
# Scores in [0.70, 0.80) require review and never create accepted attendance.
FACE_REVIEW_THRESHOLD=0.70
# Live softmax score must be at least nine times the sum of spoof class scores.
FACE_LIVENESS_THRESHOLD=0.90
# Require both manifest references in full: face size >=100 px and sharpness >=100.
FACE_QUALITY_THRESHOLD=1.00
